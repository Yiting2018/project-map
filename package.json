{
  "name": "project-map-kit",
  "version": "0.1.0",
  "description": "Configuration-driven project architecture, flows and evidence in a static dashboard",
  "type": "module",
  "license": "MIT",
  "bin": { "project-map": "bin/project-map.mjs" },
  "files": ["bin/", "src/", "examples/project-map.json", "examples/*/project*.json", "examples/*/status.json", "examples/*/architecture/**", "examples/*/states/**", "examples/*/evidence/**", "skills/", "docs/", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build:demo": "node bin/project-map.mjs build --root examples",
    "validate:demo": "node bin/project-map.mjs validate --root examples",
    "preview": "node bin/project-map.mjs serve --dir examples/dist/project-map --port 5191",
    "browser:install": "playwright install chromium"
  },
  "engines": { "node": ">=22.22.3" },
  "dependencies": {
    "@phosphor-icons/core": "2.1.1",
    "likec4": "1.59.4",
    "mermaid": "11.12.0",
    "playwright": "1.60.0"
  }
}
